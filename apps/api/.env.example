# MarketReality OS API Environment

# CoinMarketCap API Key (Required for live data)
# Get one at: https://pro.coinmarketcap.com
CMC_PRO_API_KEY=

# Base URL for CMC API (defaults to pro API)
CMC_BASE_URL=https://pro-api.coinmarketcap.com

# Enable to force demo data without hitting CMC (true/false)
DEMO_MODE=false
