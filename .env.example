# Server-side secrets only. Never commit real keys to version control.
# Copy this file to apps/api/.env and fill in your actual keys.

# CoinMarketCap Pro API key — get yours at: https://pro.coinmarketcap.com/account
CMC_PRO_API_KEY=your_cmc_pro_api_key_here
CMC_MCP_API_KEY=your_cmc_mcp_api_key_here


CMC_BASE_URL=https://pro-api.coinmarketcap.com
CMC_MCP_URL=https://mcp.coinmarketcap.com/mcp

# Cache TTL in seconds (default 120)
CACHE_TTL=120

# Frontend API base URL (used by Next.js)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
